# ==============================================================================
# ALPHX Quantitative Backend - Environment Configuration Template
# Duplicate this file as .env and fill in your confidential API keys.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Environment
DEBUG=true
PORT=8000

# CoinDCX Exchange Credentials (Leave as 'demo' to run in Paper Trading mode)
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here

# Quantitative Risk Controls
DEFAULT_LEVERAGE=3.0
MAX_RISK_PER_TRADE=0.02
MIN_CONFIDENCE=0.70

# Inbound Webhook Sentinel (TradingView / CoinDCX alerts)
WEBHOOK_SECRET_KEY=your_secure_webhook_secret_here
COINDCX_WEBHOOK_URL=https://api.coindcx.com/callbacks/v1/derivatives/futures/order/your_webhook_token
COINDCX_WEBHOOK_ID=your_webhook_id_here
WEBHOOK_AI_FILTER_ENABLED=false
WEBHOOK_MIN_CONFIDENCE=0.70

# Telegram Bot Integration (@alphx_signal_bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_channel_or_group_chat_id_here
TELEGRAM_AUTO_SEND=false
TELEGRAM_MIN_CONFIDENCE=0.70
